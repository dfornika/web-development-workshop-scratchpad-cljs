{:deps true
 :dev-http {8000 "resources/public"}
 :builds {:app {:target :browser
                :output-dir "resources/public/js"
                ;; AG Grid and other JavaScript libraries call our functions with
                ;; JavaScript objects, so the homework has interop like
                ;; (.. params -data -sampleId). shadow-cljs warns about those
                ;; ("Cannot infer target type") unless they're marked with ^js,
                ;; and the warnings pop up in the browser on every save - which
                ;; is confusing while learning. Externs inference only matters for
                ;; :advanced builds, and this build never uses :advanced, so it's off.
                :compiler-options {:infer-externs false}
                :asset-path "/js"
                :modules {:main
                          {:init-fn scratchpad.main/init}}
                :build-hooks [(shadow.cljs.build-report/hook {:output-to "build-reports/report.html"})]
                :release {:compiler-options {:optimizations :simple}}}
          ;; The single-file version (`npm run bundle`, see scripts/bundle.mjs),
          ;; which is also what GitHub Pages publishes. It's the in-browser
          ;; version (same as :web), so people without Codespaces can edit the
          ;; Playground right on the page.
          :bundle {:target :browser
                   :output-dir "target/bundle/js"
                   :asset-path "js"
                   :modules {:main
                             {:init-fn scratchpad.web.main/init}}
                   :compiler-options {:optimizations :advanced}}
          ;; The in-browser version, for development (`npm run dev:web`):
          ;; the Playground's code is edited on the page and run by SCI
          ;; (see src/main/scratchpad/web/). Served at /web.html.
          :web {:target :browser
                ;; served at http://localhost:8000/web.html
                :output-dir "resources/public/web-js"
                :asset-path "/web-js"
                :modules {:main
                          {:init-fn scratchpad.web.main/init}}
                ;; no interop warnings while developing (see :app); the release
                ;; build is :advanced, so it keeps externs inference on
                :dev {:compiler-options {:infer-externs false}}
                :release {:compiler-options {:optimizations :advanced}}}
          :test {:target :node-test
                 :output-to "target/test/test.js"
                 :ns-regexp "-test$"
                 :autorun true}}}
