{
  "name": "Web Development Workshop Scratchpad (cljs edition)",
  "build": {
    "dockerfile": "Dockerfile.dev"
  },
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  // More info: https://containers.dev/features.
  "features": {},
  // Use 'forwardPorts' to make a list of ports inside the container available locally.
  "forwardPorts": [
    8000,
    9630
  ],
  // Run commands on cluster first start. Useful for download dependencies, etc.
  "postCreateCommand": "./scripts/post-create.sh",
  // Copy host env vars into the devcontainer.  You can also refer to some_file.env files in your docker or docker-compose setup.
  "remoteEnv": {},
  "customizations": {
    "vscode": {
      "extensions": [
        "betterthantomorrow.calva"
      ],
      "settings": {
        "calva.useLegacyReplWindowPath": false,
        "calva.replConnectSequences": [
          {
            "name": "Preconfigured REPL Connect",
            "projectType": "deps.edn",
            "autoSelectForJackIn": true,
            "cljsType": {
              "dependsOn": "shadow-cljs",
              "startCode": "(do (shadow.cljs.devtools.server/start!) (shadow.cljs.devtools.api/watch :app))",
              "connectCode": "(shadow.cljs.devtools.api/nrepl-select :app)"
            },
            "menuSelections": {
              "cljsLaunchBuilds": [
                ":app"
              ],
              "cljAliases": [
                ":dev"
              ],
              "cljsDefaultBuild": ":app"
            }
          }
        ]
      }
    }
  }
}